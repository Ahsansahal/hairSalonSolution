# ==========================================================
# Multi-Branch Salon Management System - Environment Template
# Copy this file to .env and fill in values for your setup.
# ==========================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=change-me-in-production-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database Configuration ---
# Leave DATABASE_URL blank in local non-Docker development to use SQLite automatically,
# or provide a PostgreSQL URL for Docker / production:
# DATABASE_URL=postgres://salon_user:salon_password_placeholder@localhost:5432/salon_db
POSTGRES_DB=salon_db
POSTGRES_USER=salon_user
POSTGRES_PASSWORD=salon_password_placeholder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- CORS & Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- WhatsApp Business Platform (Meta Cloud API) ---
# Until live credentials are provided, the system operates in verified local simulation mode.
WHATSAPP_PROVIDER_ENABLED=False
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=salon_whatsapp_verify_token_placeholder
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here

# --- Biometric Attendance Middleware ---
BIOMETRIC_DEFAULT_WEBHOOK_SECRET=biometric_webhook_secret_placeholder

# --- Payment Gateway ---
PAYMENT_GATEWAY_PROVIDER=simulated
PAYMENT_GATEWAY_SECRET_KEY=payment_gateway_secret_placeholder
